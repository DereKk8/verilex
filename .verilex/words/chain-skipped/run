#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # keep the shared words directory, and so its stamp, unchanged
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from canary_word import CHAIN, fail, launched, left_behind, must, result, run_id, run_line, said, verilex

# Two counted uses, onboarding of every tally word, then the first (live) run after admission.
must("use-1", "run", CHAIN)
must("use-2", "run", CHAIN)
for word in ("store-open", "item-stored", "item-listed"):
    must(f"onboard-{word}", "onboard", word)
live = run_id(must("after-admission", "run", CHAIN))
done = verilex("action", "run", CHAIN)
if done.returncode != 0 or not done.stdout.startswith(f"green: 3 green, skipped: stamps match run {live}; run "):
    fail(f"the second run after onboarding was not skipped on run {live}: exit {done.returncode}, {said(done)}")
skipped = run_id(done)
line = run_line(skipped)
if "cleanup=none" not in line.split():
    fail(f"verilex runs does not show {skipped} with cleanup=none: {line!r}")
if skipped in launched():
    fail(f"the skipped run {skipped} launched a store: {launched()[skipped]}")
if left_behind():
    fail(f"the skipped run {skipped} left stores behind: {left_behind()}")
result("pass", observation=f"verilex runs shows {skipped} with cleanup=none, and no store exists")
