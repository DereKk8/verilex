#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from self_word import (c, source, start, expect, doc, baseline, external, setup,
                       json, shutil, subprocess)


def agent_diff_request():
    baseline()
    tally = c.instance / "tally"
    setup("git-init", ["git", "init", "-q"], tally, clean_git=True)
    setup("git-add", ["git", "add", "-A"], tally, clean_git=True)
    setup("git-commit", ["git", "-c", "user.name=canary", "-c", "user.email=canary@localhost", "commit", "-qm", "base"], tally, clean_git=True)
    binary = tally / "bin/tally"
    binary.write_text(binary.read_text() + "\n# diff probe\n")
    skill = c.instance / "skill.md"
    skill.write_text("Prove that the store opens.\n")
    brain = c.instance / "brain"
    brain.write_text("#!/bin/sh\nverilex run --claim store-opened\n")
    brain.chmod(0o755)
    flags = [c.instance / "bin/verilex-agent", "--project", tally, "--verilex", c.instance / "bin/verilex",
             "--skill", skill, "--brain", brain, "--harness", "stub", "--model", "stub", "--claim", "store-opened", "--diff", "HEAD"]
    omitted_home = c.instance / "omitted-home"
    omitted = external("omitted-diff", [*flags, "--home", omitted_home], clean_git=True)
    if "sandbox" in omitted.stderr and "was not asked about" not in omitted.stderr:
        c.result("blocked", detail=c.said(omitted))
    # The refusal also names the claims the diff touches; the change itself must be among the gaps.
    gaps = omitted.stderr.partition("was not asked about ")[2].strip().split(", ")
    expect(omitted.returncode == 2 and omitted.stdout == "" and "change bin/tally" in gaps,
           "launcher returned a verdict for a green run that omitted bin/tally")
    runs = list((omitted_home / "tally/runs").glob("*/run.json"))
    expect(len(runs) == 1, "omitting brain left no single real run")
    record = json.loads(runs[0].read_text())
    (c.evidence / "omitted-run.json").write_text(json.dumps(record, indent=2))
    expect(record["verdict"] == "green" and record["requested"]["changed"] == [], "refusal did not observe a genuine green without the diff")
    brain.write_text("#!/bin/sh\nverilex run --changed bin/tally\n")
    covered = external("covered-diff", [*flags, "--home", c.instance / "covered-home"], clean_git=True)
    expect(covered.returncode == 0, f"covered diff did not return green: {c.said(covered)}")
    doc = json.loads(covered.stdout)
    expect(doc["verdict"] == "green" and doc["requested"]["changed"] == ["bin/tally"] and not c.stores(), "covered run failed its second view")
    c.result("pass", observation="launcher refuses omitted bin/tally with exit 2 and empty stdout although its run record is green; a run requested with bin/tally returns green and leaves no store")


try:
    start("self-agent-diff-request")
    agent_diff_request()
except (OSError, subprocess.TimeoutExpired) as error:
    c.result("blocked", detail=str(error))
