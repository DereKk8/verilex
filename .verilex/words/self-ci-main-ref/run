#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from self_word import (c, source, start, expect, doc, baseline, external, setup,
                       json, shutil, subprocess)


def ci_main_ref():
    tree = c.instance / "ci-tree"
    (tree / "scripts").mkdir(parents=True)
    for name in ("ci", "canary-guards"):
        shutil.copyfile(source / "scripts" / name, tree / "scripts" / name)
        (tree / "scripts" / name).chmod(0o755)
    setup("ci-init", ["git", "init", "-q"], tree, clean_git=True)
    setup("ci-add", ["git", "add", "."], tree, clean_git=True)
    setup("ci-commit", ["git", "-c", "user.name=canary", "-c", "user.email=canary@localhost", "commit", "-qm", "base"], tree, clean_git=True)
    setup("ci-tag", ["git", "tag", "refs/remotes/origin/main"], tree, clean_git=True)
    ref = external("branch-absent", ["git", "show-ref", "--verify", "refs/remotes/origin/main"], tree, clean_git=True)
    expect(ref.returncode != 0, "test tree unexpectedly has the origin/main branch ref")
    ci = external("ci-refused", [tree / "scripts/ci", "canary"], tree, clean_git=True)
    guards = external("guards-refused", [tree / "scripts/canary-guards"], tree, clean_git=True)
    expect(ci.returncode == 1 and "canary: refs/remotes/origin/main is absent" in ci.stdout,
           "CI accepted a tag in place of the missing origin/main branch ref")
    expect(guards.returncode == 2 and "canary-guards: refs/remotes/origin/main is absent" in guards.stderr,
           "canary-guards accepted a tag in place of the missing origin/main branch ref")
    c.result("pass", observation="with only a tag named refs/remotes/origin/main, scripts/ci canary exits 1 and canary-guards exits 2 naming the absent branch ref; git show-ref independently confirms the branch is absent")


try:
    start("self-ci-main-ref")
    ci_main_ref()
except (OSError, subprocess.TimeoutExpired) as error:
    c.result("blocked", detail=str(error))
