#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from self_word import (c, source, start, expect, doc, baseline, external, setup,
                       json, shutil, subprocess)


def index_tiers():
    expect(doc("pristine", "index") == [], "pristine product lists active claims")
    baseline()
    active = doc("tier-1", "index")
    expect([x["claim"] for x in active] == ["item-added", "item-listed", "store-opened"],
           "tier 1 did not list the three admitted claims")
    tier2 = doc("tier-2", "index", "item-added")
    expect([(w["word"], w["state"]) for w in tier2["words"]] == [("item-stored", "active")],
           "tier 2 did not show item-stored active")
    tier3 = c.must("tier-3", "index", "item-added", "item-stored").stdout
    expect("item-stored <name>  proves item-added@" in tier3 and "; admitted" in tier3
           and "proven on: store-open | item-stored apple" in tier3, "tier 3 lost the admitted binding")
    config = c.instance / "tally/.verilex/config.yaml"
    config.write_text(config.read_text().replace("project: tally", "project: tally-b"))
    expect(doc("other-product", "index") == [], "another product inherited active claims")
    expect(doc("dormant", "index", "item-added")["words"][0]["state"] == "dormant",
           "another product did not mark item-stored dormant")
    c.result("pass", observation="tier 1 lists item-added, item-listed, store-opened; tier 2 shows item-stored active; tier 3 shows admitted apple; tally-b lists no active claims and item-stored dormant")


try:
    start("self-index-tiers")
    index_tiers()
except (OSError, subprocess.TimeoutExpired) as error:
    c.result("blocked", detail=str(error))
