#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from self_word import (c, source, start, expect, doc, baseline, external, setup,
                       json, shutil, subprocess)


def plan_binding():
    baseline()
    isolated = str(c.instance / "new-home")
    before = c.must("runs-before", "runs", VERILEX_HOME=isolated).stdout
    plan = doc("bound", "plan", "--claim", "item-listed", VERILEX_HOME=isolated)
    expect(plan["chain"] == c.CHAIN and plan["order"] == ["store-opened", "item-added", "item-listed"],
           "claim plan failed to bind apple and its providers from admission")
    after = c.must("runs-after", "runs", VERILEX_HOME=isolated).stdout
    expect(before == after == "", "plan ran something in the fresh home")
    run = doc("execute", "run", "--claim", "item-listed", VERILEX_HOME=isolated)
    expect(run["verdict"] == "green" and [" ".join([s["word"], *(s["args"] or [])]) for s in run["words"]] == ["store-open", "item-stored apple", "item-listed apple"],
           "claim run did not execute the bound chain")
    records = doc("runs-executed", "runs", VERILEX_HOME=isolated)
    expect(len(records) == 1 and records[0]["chain"] == c.CHAIN, "run record lost the admitted chain")
    c.result("pass", observation="fresh-home claim plan binds store-open | item-stored apple | item-listed apple with provider order and writes no run; execution is green and its run record holds that chain")


try:
    start("self-plan-binding")
    plan_binding()
except (OSError, subprocess.TimeoutExpired) as error:
    c.result("blocked", detail=str(error))
