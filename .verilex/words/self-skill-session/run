#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from self_word import (c, source, start, expect, doc, baseline, external, setup,
                       json, shutil, subprocess)


def skill_session():
    scripts = source / ".cursor/skills/verify-verilex/scripts"
    temp = c.instance / "tmp"
    temp.mkdir()
    candidate = c.instance / "candidate"
    shutil.copyfile(c.instance / "bin/verilex", candidate)
    candidate.chmod(0o755)
    launched = setup("launch-session", [scripts / "launch", "--bin", candidate], TMPDIR=str(temp))
    session = Path(next(s[9:] for s in launched.stdout.splitlines() if s.startswith("session: ")))
    expect(session.parent == temp, "launch created a session outside its requested temporary directory")
    try:
        healthy = external("doctor-healthy", [scripts / "doctor", session])
        expect(healthy.returncode == 0 and "doctor: ok" in healthy.stdout, "doctor refused a healthy session")
        pinned = (session / "bin/verilex").read_bytes()
        candidate.write_bytes(candidate.read_bytes() + b"\nexternal rebuild\n")
        expect((session / "bin/verilex").read_bytes() == pinned, "launch did not freeze the --bin executable")
        expect(external("doctor-after-rebuild", [scripts / "doctor", session]).returncode == 0,
               "rebuilding source binary changed the frozen session")
        (session / "bin/verilex").write_bytes(pinned + b"\nchanged session\n")
        bad = external("doctor-tampered", [scripts / "doctor", session])
        expect(bad.returncode == 1 and "doctor: FAIL binary changed since launch" in bad.stdout, "doctor accepted a tampered session binary")
        (session / "bin/verilex").write_bytes(pinned)
    finally:
        # Only this exact session, created above. No glob can name another worker's session.
        cleaned = external("cleanup-session", [scripts / "cleanup", session])
        expect(cleaned.returncode == 0 and not session.exists(), "cleanup did not remove our exact session")
    c.result("pass", observation="launch freezes --bin across a source rebuild; doctor accepts the frozen session and refuses tampering with exit 1; cleanup removes only the exact session launched by this word")


try:
    start("self-skill-session")
    skill_session()
except (OSError, subprocess.TimeoutExpired) as error:
    c.result("blocked", detail=str(error))
