{
  "version": 1,
  "summary": "Clean step-owned CI scratch directories on success, failure and interruption.",
  "files": [{
    "path": "scripts/ci",
    "summary": "Give each scratch-owning step an exit trap without changing its checks.",
    "annotations": [
      {
        "newRange": [25, 30],
        "summary": "remove_temp makes read-only test evidence writable before deleting owned scratch.",
        "rationale": "Test evidence can contain read-only directories, so plain rm can leave scratch behind. Failure, SIGINT and SIGTERM probes populated read-only evidence and left no entries. SIGKILL cannot run shell traps.",
        "author": "fm/verilex-ci-tmp-leak"
      },
      {
        "newRange": [66, 75],
        "summary": "test_ only registers cleanup for coverage directories it creates.",
        "rationale": "COVER_OUT belongs to the caller, so the step clears old contents without deleting the directory itself. Full scripts/ci retained its original inode and generated coverage. Default coverage scratch disappeared after success and failure.",
        "author": "fm/verilex-ci-tmp-leak"
      },
      {
        "newRange": [140, 141],
        "summary": "canary no longer advertises evidence that its exit trap removes.",
        "rationale": "The cleanup requirement covers failed canaries too, so retaining state or printing its deleted path would be wrong. Main leaked one state directory on an injected build failure. This branch leaves none and preserves failure status.",
        "author": "fm/verilex-ci-tmp-leak"
      }
    ]
  }]
}
