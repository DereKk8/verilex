      "summary": "Regression tests that replay attacks on the canary step against scratch copies of the checkout.",
      "annotations": [
        {
          "newRange": [
            1,
            94
          ],
          "summary": "Each case copies the tracked files, gives the copy a bare git dir that borrows this repository's objects, plants one attack, and runs the real step.",
          "rationale": "The shim keeps the checkout and the repository's refs untouched, so a tag named origin/main can exist only in the copy. A clean copy must stay green, so an attack case cannot pass by breaking the copy. About 12 s locally.",
          "author": "fm/verilex-canary-next"
        }
      ]
