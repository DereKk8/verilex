{
  "version": 1,
  "summary": "Adds verilex onboard, which admits claim words through mechanical checks and planted-defect trials and returns ambiguous grouping to the calling agent, plus the generated three-tier verilex index.",
  "files": [
    {
      "path": "internal/grouping/grouping.go",
      "summary": "Owns the sealed grouping file and the one deterministic reading of which claim is grouped under which.",
      "annotations": [
        {
          "newRange": [222, 260],
          "summary": "Groups and Open read sound decisions in word order, and the first decision that places a claim wins.",
          "rationale": "Onboarding and the index used to build this map by ranging over a Go map, so conflicting decisions gave different groupings and index output between calls. Both now call Groups, so the result depends only on the file. TestEveryWordOfAnUndecidedClaimWaitsForTheAgent compares the index output over 20 calls.",
          "author": "fm/verilex-onboarding"
        }
      ]
    },
    {
      "path": "internal/onboarding/onboarding.go",
      "summary": "Owns the onboarding pipeline from usefulness through the sealed grouping decision.",
      "annotations": [
        {
          "newRange": [358, 395],
          "summary": "candidates adds the open questions of an undecided grouped claim as ambiguous candidates for every later word of that claim.",
          "rationale": "A second word on an undecided claim used to join as same with no question, so the claim later became both a group and an alias. Each later word is now compared with the pending claim's words, so a later --same-as moves only words that behaved like them. A word that disagrees with the pending claim keeps no question, and the answer is then refused.",
          "author": "fm/verilex-onboarding"
        },
        {
          "newRange": [295, 320],
          "summary": "decide rejects only on findings against same or matched claims, and marks the word Undecided when it agrees with inherited pending claims.",
          "rationale": "Findings against an ambiguous candidate mean only that the claims may differ, so they remove that candidate from the question instead of rejecting the word. Verified by the full onboard.md recipe and go test ./....",
          "author": "fm/verilex-onboarding"
        },
        {
          "newRange": [495, 570],
          "summary": "settle applies one agent answer to every word grouped under the undecided claim, and refuses --same-as while one of them lacks that pending claim.",
          "rationale": "The design record makes the calling agent the only judge, and verilex makes no model call. Moving all words keeps identical words in one group. No test covers the refusal path for a word that was never compared, because no tally word can agree with a claim's words and disagree with the pending claim's words.",
          "author": "fm/verilex-onboarding"
        }
      ]
    },
    {
      "path": "internal/index/changed.go",
      "summary": "Implements the model-free change lookup that reuses plan's skip decision.",
      "annotations": [
        {
          "newRange": [93, 99],
          "summary": "Changed adds the grouped claim's file and sources to the dependencies of a word grouped under another claim.",
          "rationale": "Drift checks judge an alias word against its grouped claim, so plan re-runs that word's chains after the grouped claim changes. Without this dependency the lookup omitted those chains. TestChangeLookupFollowsAliasWordsToTheirGroupedClaim covers both a planted-defect addition and a new version. PER-245 can take this lookup as plan's diff input later; it is not built here.",
          "author": "fm/verilex-onboarding"
        }
      ]
    },
    {
      "path": "internal/index/index.go",
      "summary": "Builds the three index tiers from the claims, words and grouping file.",
      "annotations": [
        {
          "newRange": [100, 120],
          "summary": "Build counts a decision only when it pins the claim version the word pins now.",
          "rationale": "A word re-pinned without onboarding used to make its new claim active in tier 1. That word is now provisional there. TestRepinnedWordIsNotActiveUnderItsNewClaim and the index.md Re-pinned word step verify this.",
          "author": "fm/verilex-onboarding"
        }
      ]
    },
    {
      "path": "internal/lifecycle/lifecycle.go",
      "summary": "Derives admission, drift and requirement coverage for claim words from the grouping decision.",
      "annotations": [
        {
          "newRange": [142, 146],
          "summary": "Curated requires a sound onboarding decision that pins the current claim with unchanged sources and an unchanged word digest.",
          "rationale": "Only onboarding admits claim words now, so requirement coverage follows the decision, keyed by repository and sub-feature. The claims.md Onboarded word covers step and tests/claims_test.go verify it. The seal is an unkeyed checksum, so a deliberate forgery is not caught; the README says so, and a keyed seal needs a design decision.",
          "author": "fm/verilex-onboarding"
        }
      ]
    },
    {
      "path": "internal/stamp/stamp.go",
      "summary": "Adds the onboarding seal to a claim word's proof stamp.",
      "annotations": [
        {
          "newRange": [156, 164],
          "summary": "The word admission component holds the decision seal, so onboarding or a hand edit makes the next run live.",
          "rationale": "A curator admission already worked this way for words without a claim. If the grouping file cannot be read, the reason is unclear, so the chain runs live. Verified by the onboard.md Stamp step.",
          "author": "fm/verilex-onboarding"
        }
      ]
    },
    {
      "path": "internal/curation/admit.go",
      "summary": "Keeps propose and admit for words without a claim only.",
      "annotations": [
        {
          "newRange": [54, 64],
          "summary": "Admit refuses a word that proves a claim and points to verilex onboard instead.",
          "rationale": "A second admission path would let a curator skip the planted-defect gate. The propose.md and admit.md recipes show that curator flows for words without a claim are unchanged.",
          "author": "fm/verilex-onboarding"
        }
      ]
    }
  ]
}
