{
  "version": 1,
  "summary": "verilex redacts every secret it detects in evidence, names, link targets and decoded reports before it reads them, and verify-verilex capture keeps only safe reproduction controls from the inherited environment.",
  "files": [
    {
      "path": "internal/runner/evidence.go",
      "summary": "Owns secret detection and redaction of word and frame evidence, names, links and decoded reports.",
      "annotations": [
        {
          "newRange": [
            25,
            30
          ],
          "summary": "Each built-in token pattern starts with tokenStart, and the private key pattern spans the whole block.",
          "rationale": "Redaction replaces only what a pattern matches, so a header-only key match would leave the key body. regexp2's \\b treats _ and non-ASCII letters as word characters, and an encoded byte such as %3D or \\n ends in a letter, so tokens after them gave a green run (PX-2, PX-3). The secret-after-* rows in TestDishonestWordResultsAreInconclusive cover each case.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            48,
            66
          ],
          "summary": "scan opens directories the word left closed and restores their modes after the walk and the renames.",
          "rationale": "WalkDir calls the callback for a directory before it reads it, so a chmod there lets a mode-000 directory be scanned instead of failing with an internal error (PX-6). Renames update the recorded paths, so the deferred restore reaches the renamed directory. TestEvidenceWithoutReadPermissionIsScanned checks both a clean and a secret case and the kept mode 000.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            104,
            138
          ],
          "summary": "scan renames entries whose names hold a secret, and scanFile handles one file or link.",
          "rationale": "A token used as a name reached the cause and the records (D2). For a link, scanFile checks the target path (PX-7), skips a link it cannot follow (PX-5), and never reads an unreadable target with changed bits, because the target is outside the evidence.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            140,
            178
          ],
          "summary": "A link whose target path or content holds a secret becomes a file holding only [redacted].",
          "rationale": "Copying the target with only matches redacted would write secrets no pattern knows, such as a database password, into durable evidence (D3). TestSymlinkedSecretFileIsNotCopiedIntoEvidence checks that hunter2 is in no state file and the outside file is unchanged.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            201,
            231
          ],
          "summary": "redactJudgment decodes the whole report and redacts the three recorded fields.",
          "rationale": "An escaped token in a field verilex does not record, such as extra, still stays in stdout, so every field counts (D4). A hit replaces the whole stdout, because the raw position of an escaped token is unknown. TestEscapedSecretInAnyReportFieldIsRedacted covers this.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            259,
            352
          ],
          "summary": "redactValue numbers keys that redact alike, and withBits retries a refused change with owner bits added, then restores the mode.",
          "rationale": "Two secret keys both became [redacted], so one value was lost (D5); TestRedactedReportKeysKeepEveryValue checks both values. withBits serves the read-only directory case (D1) and unreadable files (PX-6) with one restore rule.",
          "author": "fm/verilex-secret-evidence"
        }
      ]
    },
    {
      "path": "internal/runner/runner.go",
      "summary": "Runs the scan before reading evidence and checks decoded values of the launch output and of each word report.",
      "annotations": [
        {
          "newRange": [
            294,
            308
          ],
          "summary": "drive treats a secret in the decoded launch output like a raw launch leak: exit 2, no instance recorded.",
          "rationale": "The raw scan cannot see a JSON-escaped token, which run.json would then store in instance. Without a recorded instance the cleanup frame finds the store by the run label, as it already does for a raw leak. TestEscapedSecretInLaunchInstanceIsNotRecorded checks that no store is left.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            408,
            412
          ],
          "summary": "The scan moved ahead of the stdout read and verdict.Judge.",
          "rationale": "Detail, observation and reason come from redacted stdout, so run.json, the usage ledger, --json output and the launcher JSON hold no detected secret. On main the token from the verdicts.md attack reached all four.",
          "author": "fm/verilex-secret-evidence"
        },
        {
          "newRange": [
            424,
            426
          ],
          "summary": "A secret that only decoding shows makes the word inconclusive with the cause 'secret pattern in evidence stdout'.",
          "rationale": "Before, such a report ended red or green with the token in run.json and the usage ledger. Inconclusive keeps the honesty rule that a report with a secret is never backed.",
          "author": "fm/verilex-secret-evidence"
        }
      ]
    },
    {
      "path": ".cursor/skills/verify-verilex/scripts/capture",
      "summary": "Writes the env evidence file with values for reproduction controls only.",
      "annotations": [
        {
          "newRange": [
            27,
            36
          ],
          "summary": "capture lists exported names with compgen -e and withholds every value outside the control allowlist.",
          "rationale": "Evidence is meant to be shared, so an inherited secret with a TALLY_, VERILEX_ or VX_ name must not be saved (issue 59). compgen -e avoids parsing env output, where a value with a newline could forge a line. The ledger variables are safe to record because capture refuses them unless they point inside the session.",
          "author": "fm/verilex-secret-evidence"
        }
      ]
    },
    {
      "path": "scripts/smoke",
      "summary": "Adds the regression for issue 59 through the public vx entry point.",
      "annotations": [
        {
          "newRange": [
            13,
            19
          ],
          "summary": "smoke runs vx with a public canary variable and fails if the canary value appears anywhere in the evidence.",
          "rationale": "This check failed on main with 'smoke: capture evidence kept an inherited value' and passes on this branch. It also checks that TALLY_DEFECT keeps its value, so the allowlist still records reproduction controls.",
          "author": "fm/verilex-secret-evidence"
        }
      ]
    }
  ]
}
