#!/usr/bin/env bash
# The blocking checks. CI calls each step; run with no argument to run them all.
# usage: scripts/ci [lint|mod|vuln|test|test-core|test-agent|build|smoke|boundary|site|canary|canary-guards|author-prompts ...]
set -euo pipefail
cd "$(dirname "$0")/.."

lint() {
  unformatted=$(gofmt -l .)
  [ -z "$unformatted" ] || { echo "unformatted files (run gofmt -w .):"; echo "$unformatted"; return 1; }
  go vet ./...
  go tool staticcheck ./...
  go tool actionlint
  shellcheck .cursor/skills/verify-verilex/scripts/* .verilex/frame/* scripts/ci scripts/ci-guards scripts/canary-guards scripts/smoke scripts/docs scripts/author-prompts-check
  go vet ./agent/...
  go tool staticcheck ./agent/...
}
mod() {
  go mod verify
  go mod tidy -diff || { echo "go.mod or go.sum is stale (run go mod tidy)"; return 1; }
  (cd agent && go mod tidy -diff) || { echo "agent/go.mod is stale (run go mod tidy in agent)"; return 1; }
  (cd site && GOWORK=off GOTOOLCHAIN=auto go mod verify && GOWORK=off GOTOOLCHAIN=auto go mod tidy -diff) ||
    { echo "site/go.mod is stale (run GOWORK=off go mod tidy in site)"; return 1; }
}
boundary() { go run scripts/boundary.go; }
# Test evidence may be read-only. Make owned scratch writable before removing it.
remove_temp() {
  chmod -R u+w "$1"
  rm -rf "$1"
}
vuln() (
  # govulncheck cannot map a distro-suffixed `go version` (go1.27.2-X:nodwarf5) and then reports no
  # standard-library findings, so each module is scanned with the exact release its go.mod names.
  root="go$(go mod edit -print | sed -n 's/^go //p')"
  GOTOOLCHAIN="$root" go tool govulncheck ./...
  # site/ keeps its own dependencies, outside go.work; the same govulncheck checks them, against
  # the standard library of the Go its go.mod requires.
  tools="$(mktemp -d)"
  trap 'remove_temp "$tools"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  GOTOOLCHAIN="$root" go build -o "$tools" golang.org/x/vuln/cmd/govulncheck
  site="go$(GOWORK=off go -C site mod edit -print | sed -n 's/^go //p')"
  (cd site && GOWORK=off GOTOOLCHAIN="$site" "$tools/govulncheck" ./...)
)
# The docs web app: a module of its own, outside go.work, so the core and the launcher keep no
# dependencies. Vetted with the core's staticcheck, tested, and every docs link and anchor checked.
# It is a server, so its go.mod requires a Go whose net/http has the latest fixes; GOTOOLCHAIN=auto
# fetches that Go where CI pins an older one.
site() (
  tools="$(mktemp -d)"
  trap 'remove_temp "$tools"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  go build -o "$tools" honnef.co/go/tools/cmd/staticcheck
  (
    cd site
    export GOWORK=off GOTOOLCHAIN=auto
    go vet ./...
    "$tools/staticcheck" ./...
    go test -race ./...
    go run . check -root ..
  )
)
test_() { test_core; test_agent; }
test_core() (
  # tests/ builds verilex itself; the instrumented binary writes coverage to GOCOVERDIR, which go test would override
  if [ -n "${COVER_OUT:-}" ]; then
    mkdir -p "$COVER_OUT"
    cover="$(cd "$COVER_OUT" && pwd -P)"
    if [ "$cover" = / ] || [[ "$(pwd -P)/" == "$cover/"* ]]; then
      echo "COVER_OUT must not be the checkout or a parent of it: $COVER_OUT" >&2
      return 1
    fi
  else
    cover="$(mktemp -d)"
    trap 'remove_temp "$cover"' EXIT
  fi
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkdir -p "$cover"
  find "$cover" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  # shellcheck disable=SC2046
  go test -race $(go list ./... | grep -v '/tests$')
  go test -race -c -o "$cover/tests.test" ./tests
  (cd tests && GOFLAGS="${GOFLAGS:-} -cover" GOCOVERDIR="$cover" "$cover/tests.test")
  # Each instrumented child wrote to its own subdirectory; gather one covmeta (all are identical) and every counter file so covdata reads one directory however many children ran.
  find "$cover" -mindepth 2 -name 'covmeta.*' -print -quit | while read -r meta; do mv "$meta" "$cover"; done
  find "$cover" -mindepth 2 -name 'covcounters.*' -exec sh -c 'mv "$@" "$0"' "$cover" {} +
  go tool covdata percent -i="$cover"
)
test_agent() { (cd agent && go test -race ./...); }
build() {
  go build -o /dev/null ./cmd/verilex
  go build -o /dev/null ./agent/cmd/verilex-agent
}
smoke() { scripts/smoke; }

# The verilex build that grades the canary: a reviewed, known-good commit. Never the build under test,
# which could grade its own regression green. Bump it only in a reviewed change, built from main.
canary_driver=a5ce6bc9b9fcbc2bcf2789ea0386384a04ac5daa
canary() (
  # verilex proves its own claims (.verilex/) on this checkout: live, in throwaway state, so no ledger
  # written by earlier code can skip a step, and red when a canary word drifted or is not admitted.
  # The driver must be a commit main already holds: a commit only this branch holds could grade itself green.
  # Resolved with show-ref --verify, which takes the branch ref only: rev-parse and merge-base fall back
  # to a tag named refs/remotes/origin/main when the branch is absent.
  main="$(git show-ref --verify --hash refs/remotes/origin/main)" ||
    { echo "canary: refs/remotes/origin/main is absent (run: git fetch origin main)"; return 1; }
  git merge-base --is-ancestor "$canary_driver" "$main" ||
    { echo "canary: driver $canary_driver is not on origin/main"; return 1; }
  state="$(mktemp -d)"
  trap 'remove_temp "$state"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkdir "$state/driver"
  git archive "$canary_driver" | tar -x -C "$state/driver"
  (cd "$state/driver" && go build -o "$state/verilex" ./cmd/verilex)
  # Python keeps its bytecode out of the checkout, so a planted .pyc can never stand in for a word's source.
  export VERILEX_HOME="$state/home" VERILEX_LEDGER="$state/ledger" XDG_CONFIG_HOME="$state/config" \
    CANARY_INSTANCES="$state/instances" PYTHONPYCACHEPREFIX="$state/pycache"
  chain="" words=0
  for word in .verilex/words/*/word.md; do word="${word%/word.md}"; chain="${chain:+$chain | }${word##*/}"; words=$((words + 1)); done
  # The diff only adds warnings to a live run of every word, so without a merge base the verdict is the same.
  changed=()
  if base="$(git merge-base "$main" HEAD)"; then
    while IFS= read -r path; do changed+=(--changed "$path"); done < <(git diff --name-only "$base")
  else
    echo "canary: no merge base with origin/main; the run names no changed files"
  fi
  ok=true
  # bash 3.2 (macOS) treats an empty array as unbound under set -u, as on main where the diff is empty.
  "$state/verilex" run --fresh ${changed[@]+"${changed[@]}"} "$chain" || ok=false
  drift="$("$state/verilex" check)" || ok=false
  echo "$drift"
  # Every canary word must be admitted: a word turned provisional is not drift, so the count is the check.
  [ "$drift" = "check: no drift ($words admitted)" ] || ok=false
  provisional="$("$state/verilex" words | awk '/^[^ ]/ { w = $1 } /status: +provisional/ { printf "%s%s", s, w; s = ", " }')" ||
    ok=false
  [ -z "$provisional" ] || echo "canary: not admitted, so not proven: $provisional"
  # Every canary claim must keep an admitted word: deleting a word but keeping its claim is not drift either.
  active="$("$state/verilex" index | tail -n +2 | cut -d' ' -f1)" || ok=false
  for claim in .verilex/claims/*.yaml; do
    claim="${claim##*/}"; claim="${claim%.yaml}"
    grep -qxF "$claim" <<<"$active" || { echo "canary: claim $claim has no admitted word"; ok=false; }
  done
  if $ok; then return; fi
  echo "canary red: reproduce with scripts/ci canary"
  return 1
)

steps=("$@"); [ $# -gt 0 ] || steps=(lint mod vuln test build smoke boundary site canary canary-guards author-prompts)
for step in "${steps[@]}"; do
  echo "== $step"
  case "$step" in
    lint|mod|vuln|build|smoke|boundary|site|canary) "$step" ;;
    test) test_ ;;
    test-core) test_core ;;
    test-agent) test_agent ;;
    canary-guards) scripts/ci-guards; scripts/canary-guards ;;
    author-prompts) scripts/author-prompts-check ;;
    *) echo "unknown step: $step" >&2; exit 2 ;;
  esac
done
