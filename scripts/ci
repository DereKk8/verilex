#!/usr/bin/env bash
# The blocking checks. CI calls each step; run with no argument to run them all.
# usage: scripts/ci [lint|mod|vuln|test|build|smoke|canary ...]
set -euo pipefail
cd "$(dirname "$0")/.."

lint() {
  unformatted=$(gofmt -l .)
  [ -z "$unformatted" ] || { echo "unformatted files (run gofmt -w .):"; echo "$unformatted"; return 1; }
  go vet ./...
  go tool staticcheck ./...
  go tool actionlint
  shellcheck .cursor/skills/verify-verilex/scripts/* .verilex/frame/* scripts/ci scripts/smoke
}
mod() {
  go mod verify
  go mod tidy -diff || { echo "go.mod or go.sum is stale (run go mod tidy)"; return 1; }
}
vuln() { go tool govulncheck ./...; }
test_() {
  # tests/ builds verilex itself; the instrumented binary writes coverage to GOCOVERDIR, which go test would override
  cover="${COVER_OUT:-$(mktemp -d)}"
  rm -rf "$cover" && mkdir -p "$cover"
  # shellcheck disable=SC2046
  go test -race $(go list ./... | grep -v '/tests$')
  go test -race -c -o "$cover/tests.test" ./tests
  (cd tests && GOFLAGS="${GOFLAGS:-} -cover" GOCOVERDIR="$cover" "$cover/tests.test")
  go tool covdata percent -i="$cover"
}
build() { go build -o /dev/null ./cmd/verilex; }
smoke() { scripts/smoke; }

# The verilex build that grades the canary: a reviewed, known-good commit. Never the build under test,
# which could grade its own regression green. Bump it only in a reviewed change, built from main.
canary_driver=de9405b18d66fb652b5febf59e8efe713c301872
canary() (
  # verilex proves its own claims (.verilex/) on this checkout: live, in throwaway state, so no ledger
  # written by earlier code can skip a step, and red when an admitted canary word drifted.
  state="$(mktemp -d)"
  mkdir "$state/driver"
  git archive "$canary_driver" | tar -x -C "$state/driver"
  (cd "$state/driver" && go build -o "$state/verilex" ./cmd/verilex)
  export VERILEX_HOME="$state/home" VERILEX_LEDGER="$state/ledger" XDG_CONFIG_HOME="$state/config" \
    CANARY_INSTANCES="$state/instances"
  chain=""
  for word in .verilex/words/*/; do word="${word%/}"; chain="${chain:+$chain | }${word##*/}"; done
  changed=()
  if base="$(git merge-base origin/main HEAD 2>/dev/null)"; then
    while IFS= read -r path; do changed+=(--changed "$path"); done < <(git diff --name-only "$base")
  else
    echo "canary: no origin/main to diff against; the run names no changed files"
  fi
  ok=true
  "$state/verilex" run --fresh "${changed[@]}" "$chain" || ok=false
  drift="$("$state/verilex" check)" || ok=false
  echo "$drift"
  [[ "$drift" == "check: no drift"* ]] || ok=false
  if $ok; then rm -rf "$state"; return; fi
  echo "canary red: evidence kept in $state; reproduce with scripts/ci canary"
  return 1
)

steps=("$@"); [ $# -gt 0 ] || steps=(lint mod vuln test build smoke canary)
for step in "${steps[@]}"; do
  echo "== $step"
  case "$step" in
    lint|mod|vuln|build|smoke|canary) "$step" ;;
    test) test_ ;;
    *) echo "unknown step: $step" >&2; exit 2 ;;
  esac
done
