#!/usr/bin/env python3
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # keep the shared words directory, and so its stamp, unchanged
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from tally_word import result, stored_items, tally

name = sys.argv[1]
listed = tally("list").stdout.split()
if name not in listed:
    result("fail", preconditions_held=True, detail=f"tally list printed {listed}, not {name}")
items = stored_items()
if listed != items:
    result("fail", preconditions_held=True, detail=f"tally list printed {listed}; store.json holds {items}")
result("pass", observation=f"tally list matches store.json: {items}")
